{
  "name": "shprd",
  "private": true,
  "version": "0.9.1",
  "description": "SHPRD: a web client for Herdr (local socket bridge + React dashboard).",
  "license": "MIT",
  "author": "Arthur",
  "homepage": "https://Nebuless.github.io/shprd/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebuless/shprd.git"
  },
  "bugs": {
    "url": "https://github.com/Nebuless/shprd/issues"
  },
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "dev:server": "cd server && bun run --hot src/index.ts",
    "dev:web": "cd web && bun run dev",
    "build:web": "cd web && bun run build",
    "build:site": "bun scripts/build-pages.ts",
    "build:server": "cd server && bun run compile",
    "build": "bun run build:web && bun run build:server",
    "postbuild": "bun run clean:bun-build",
    "build:linux-x64": "bun run build:web && cd server && bun run compile:linux-x64",
    "postbuild:linux-x64": "bun run clean:bun-build",
    "build:linux-arm64": "bun run build:web && cd server && bun run compile:linux-arm64",
    "postbuild:linux-arm64": "bun run clean:bun-build",
    "build:darwin-x64": "bun run build:web && cd server && bun run compile:darwin-x64",
    "postbuild:darwin-x64": "bun run clean:bun-build",
    "build:darwin-arm64": "bun run build:web && cd server && bun run compile:darwin-arm64",
    "postbuild:darwin-arm64": "bun run clean:bun-build",
    "build:windows-x64": "bun run build:web && cd server && bun run compile:windows-x64",
    "build:windows-arm64": "bun run build:web && cd server && bun run compile:windows-arm64",
    "build:all": "bun run build:web && cd server && bun run compile:all",
    "postbuild:all": "bun run clean:bun-build",
    "package:linux-x64": "scripts/package-release.sh linux-x64",
    "package:linux-arm64": "scripts/package-release.sh linux-arm64",
    "package:darwin-x64": "scripts/package-release.sh darwin-x64",
    "package:darwin-arm64": "scripts/package-release.sh darwin-arm64",
    "package:windows-x64": "scripts/package-release.sh windows-x64",
    "package:windows-arm64": "scripts/package-release.sh windows-arm64",
    "release:check-bump": "bun scripts/check-release-bump.ts",
    "release:prepare": "bun scripts/prepare-release.ts",
    "changelog:preview": "conventional-changelog -p conventionalcommits --stdout",
    "lint:commits": "commitlint",
    "lint:commits:last": "commitlint --last",
    "lint:commit-message": "commitlint --edit",
    "label:pr": "bun scripts/classify-pr-label.ts",
    "format": "biome format --write .",
    "format:check": "biome format . --files-ignore-unknown=true",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit && cd web && bun run typecheck && cd ../server && bun run typecheck",
    "precommit": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "install-hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/commit-msg",
    "clean:bun-build": "find server -maxdepth 1 -name '*.bun-build' -exec rm -rf {} +",
    "clean": "rm -rf web/dist server/public server/src/public-files.gen.ts server/shprd server/shprd-* && bun run clean:bun-build",
    "start:server": "cd server && bun run src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.4.1",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "conventional-recommended-bump": "12.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
